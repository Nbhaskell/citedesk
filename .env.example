# Copy to .env for local use. .env is git-ignored. No secrets belong in this file.
CITEDESK_DB_PATH=data/citedesk.db
CITEDESK_PORT=8100
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:8b
RAG_URL=http://127.0.0.1:8000
ESCALATE_ON_LOW_CONFIDENCE=true
SPAM_THRESHOLD=0.8
DUPLICATE_WINDOW_HOURS=24
MAX_BODY_CHARS=10000
DRAFT_MAX_WORDS=200
ENABLE_THINKING=false
SYNTHETIC_DATA=true
BUSINESS_FACTS_PATH=universe/facts.json
